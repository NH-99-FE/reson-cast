# Copy to .env; never commit actual values. drizzle.config.ts reads .env.
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Mux signing key ID and base64-encoded private key (server only)
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
UPLOADTHING_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public HTTPS application/tunnel URL reachable by QStash
UPSTASH_WORKFLOW_URL=
# DeepSeek (server only)
AI_API_URL=https://api.deepseek.com
API_KEY=
MODEL_ID=deepseek-flash

# Optional Agnes image generation: 1K, 16:9, URL output (server only)
IMAGE_AI_API_URL=https://apihub.agnes-ai.com/v1/images/generations
IMAGE_AI_API_KEY=
IMAGE_AI_MODEL=agnes-image-2.5-flash

# Studio realtime: requires the SQL migration and scheduled outbox scanner.
ABLY_API_KEY=
